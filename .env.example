# AI60 Growth OS — Environment Variables
# Copy this file to .env.local and fill in your credentials

# ─── OpenAI API (for AI Project Passport generator and AI Campaign Copilot) ──
# If not set, the app uses a deterministic fallback generator (always works)
VITE_OPENAI_API_KEY=

# ─── Supabase (for persistent cloud database) ─────────────────────────────────
# If not set, the app uses localStorage (fully functional for demo)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── App Config ───────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
VITE_REGISTRATION_TARGET=500
